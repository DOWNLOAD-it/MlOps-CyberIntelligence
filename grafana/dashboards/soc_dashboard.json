{
  "title": "MLSecOps SOC Dashboard",
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 38,
  "panels": [
    {
      "type": "stat",
      "title": "Total Attacks Detected",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) FROM alerts",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Attack Timeline",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 10 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(timestamp, '1s'), COUNT(*) AS attacks FROM alerts GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        }
      }
    },
    {
      "type": "table",
      "title": "Recent Threat Log",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT timestamp, attack_type, destination_port, flow_duration, confidence FROM alerts ORDER BY timestamp DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" }
        }
      }
    }
  ]
}
