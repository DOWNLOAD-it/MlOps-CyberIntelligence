# ========================================
# MLSecOps Platform — Environment Configuration
# ========================================
# Copy this file to `.env`:
#   cp .env.example .env
# Then edit the values below as needed.
# These variables are also injectable via your CI/CD provider or Komodo.

# --- Machine Learning Hyperparameters ---
ML_N_ESTIMATORS=200
ML_CONTAMINATION=0.1
ML_RANDOM_STATE=42

# --- Streaming / Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092
STREAM_MAX_RECORDS=500000
PRODUCER_BATCH_SIZE=5000
PRODUCER_CHUNK_STRIDE=1
CSV_ENCODING=cp1252
KAFKA_MAX_POLL_RECORDS=5000
KAFKA_POLL_TIMEOUT_MS=5000
KAFKA_IDLE_POLLS_LIMIT=5
KAFKA_IDLE_TIMEOUT_S=120

# --- File Export Configuration ---
EXPORT_APPEND=false

# --- MLflow Configuration ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Port Configuration (Host Machine) ---
DAGSTER_HOST_PORT=4401
MLFLOW_HOST_PORT=4402
REDPANDA_ADMIN_PORT=4403
REDPANDA_PROXY_PORT=4404
REDPANDA_KAFKA_PORT=4405
REDPANDA_INTERNAL_PORT=4406
GRAFANA_HOST_PORT=4407
API_HOST_PORT=4408
WEBAPP_HOST_PORT=4409

# --- PostgreSQL Configuration ---
POSTGRES_USER=mlsecops
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=soc_alerts

# --- External Access ---
# If accessing Redpanda from outside the server (e.g., from your laptop),
# set this to your server's public IP address or domain name (e.g., 41.250.197.226).
REDPANDA_ADVERTISE_HOST=redpanda
