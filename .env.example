# ========================================
# MLSecOps Platform Configuration (Automated Push Test 3)
# ========================================
# You can copy this file to `.env` or inject
# these variables via your CI/CD provider / Orchestrator (e.g. Komodo).

# --- Machine Learning Configuration (Multi-Model Pipeline) ---
# Random seed for reproducibility (affects train/test split, CV, and model training)
ML_RANDOM_STATE=42
# Number of CV folds used for model selection (default: 5)
ML_CV_FOLDS=5

# --- Streaming / Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
STREAM_MAX_RECORDS=500000
PRODUCER_BATCH_SIZE=5000
PRODUCER_CHUNK_STRIDE=1
CSV_ENCODING=cp1252
KAFKA_MAX_POLL_RECORDS=5000
KAFKA_POLL_TIMEOUT_MS=5000
KAFKA_IDLE_POLLS_LIMIT=5
KAFKA_IDLE_TIMEOUT_S=120

# --- File Export Configuration ---
EXPORT_APPEND=false

# --- MLflow Configuration ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Port Configuration (Host Machine) ---
DAGSTER_HOST_PORT=4301
MLFLOW_HOST_PORT=4302
REDPANDA_ADMIN_PORT=4303
REDPANDA_PROXY_PORT=4304
REDPANDA_KAFKA_PORT=4305
REDPANDA_INTERNAL_PORT=4306

# --- External Access ---
# If you are accessing Redpanda from outside the server (e.g., from your laptop),
# set this to your server's public IP address or domain name (e.g., komodo.s3.fsbm.ma)
REDPANDA_ADVERTISE_HOST=redpanda
